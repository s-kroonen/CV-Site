// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Singleton (id is always 1) - public-facing profile info.
model Profile {
  id          Int      @id @default(1)
  name        String
  sourceLang  String   @default("en") // language the base text fields are written in ("en" | "nl")
  tagline     String   @default("")
  bio         String   @default("")
  publicEmail String   @default("")
  location    String   @default("")
  socialLinks Json // [{ label: string, url: string }]
  avatarPath  String?
  resumePath  String?
  updatedAt   DateTime @updatedAt
}

// Singleton (id is always 1) - never exposed via any public API/page.
// Deliberately its own model so a public query can never accidentally
// select it just by selecting "everything" on Profile.
model PrivateContact {
  id        Int      @id @default(1)
  email     String   @default("")
  phone     String   @default("")
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  sourceLang  String    @default("en") // language the base text fields are written in ("en" | "nl")
  company     String    @default("")
  title       String    @default("")
  location    String?
  slug        String?   @unique // detail page URL, generated from title + company
  logoPath    String? // /uploads/... company or school logo
  startDate   DateTime?
  endDate     DateTime?
  description String    @default("")
  bullets     Json // string[]
  tags        Json // string[]
  sortIndex   Int       @default(0)
  archivedAt  DateTime? // hidden from the public site, restorable
  deletedAt   DateTime? // in the trash, restorable until purged
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects  Project[]
  education Education[]

  @@index([sortIndex])
}

model Education {
  id          String    @id @default(cuid())
  sourceLang  String    @default("en") // language the base text fields are written in ("en" | "nl")
  institution String    @default("")
  degree      String    @default("")
  field       String?
  slug        String?   @unique // detail page URL, generated from degree + institution
  logoPath    String? // /uploads/... company or school logo
  startDate   DateTime?
  endDate     DateTime?
  description String?
  sortIndex   Int       @default(0)
  archivedAt  DateTime? // hidden from the public site, restorable
  deletedAt   DateTime? // in the trash, restorable until purged
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  experiences Experience[]

  @@index([sortIndex])
}

model Project {
  id          String    @id @default(cuid())
  sourceLang  String    @default("en") // language the base text fields are written in ("en" | "nl")
  title       String
  slug        String    @unique
  summary     String    @default("")
  description String    @default("")
  techStack   Json // string[]
  category    String   @default("") // group on the Projects tab, e.g. "Homelab & self-hosting" (translatable)
  status      String   @default("") // "" | "ongoing" | "on_hold" | "completed" | "discontinued" | "experiment"
  kind        String   @default("") // "" | "personal" | "education" | "work" - which Projects sub-tab it appears under
  startDate   DateTime?
  endDate     DateTime?
  repoUrl     String?
  liveUrl     String?
  images      Json // string[]
  featured    Boolean   @default(false)
  sortIndex   Int       @default(0)
  archivedAt  DateTime? // hidden from the public site, restorable
  deletedAt   DateTime? // in the trash, restorable until purged
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  experiences Experience[]

  @@index([sortIndex])
}

model Skill {
  id          String    @id @default(cuid())
  sourceLang  String    @default("en") // language the base text fields are written in ("en" | "nl")
  name        String
  category    String    @default("")
  proficiency Int? // 0-100, null = don't show a level
  sortIndex   Int       @default(0)
  archivedAt  DateTime? // hidden from the public site, restorable
  deletedAt   DateTime? // in the trash, restorable until purged
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortIndex])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  ipHash    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AdminPasskey {
  id           String   @id @default(cuid())
  credentialId String   @unique
  publicKey    String // base64
  counter      Int      @default(0)
  deviceName   String?
  transports   Json? // string[]
  createdAt    DateTime @default(now())
}

// Bearer tokens for the MCP endpoint (/api/mcp). Only a SHA-256 of the token
// is stored; the plaintext is shown once at creation.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String // first characters, to recognise a token in the list
  scopes     Json // ("read" | "write" | "private")[]
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  grantId    String? // set for access tokens issued through OAuth
}

// What MCP clients did (one row per tool call).
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actor    String // token name
  tool     String
  entity   String?
  entityId String?
  ok       Boolean
  detail   String? // error message or short summary
  tokenId  String?

  @@index([at])
}

// ---- OAuth 2.1 for the MCP endpoint (lets claude.ai / Claude Desktop connect
// without a hand-pasted token). See src/lib/oauth.ts.

// Dynamically registered public clients (RFC 7591).
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  name         String
  redirectUris Json // string[]
  createdAt    DateTime @default(now())
}

// Short-lived, single-use authorization codes (stored hashed).
model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  scopes        Json
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

// One approved connection of an app. Access tokens are ApiToken rows with grantId set.
model OAuthGrant {
  id              String    @id @default(cuid())
  clientId        String
  clientName      String
  scopes          Json
  refreshHash     String    @unique
  prevRefreshHash String? // reuse of this = stolen refresh token -> revoke the grant
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
}

// The other language's version of an item's translatable text fields. The item's own
// columns hold the text in its sourceLang; this row holds the translation (see lib/translations.ts).
model Translation {
  id         String   @id @default(cuid())
  entity     String // "profile" | "experience" | "education" | "projects" | "skills"
  entityId   String // "1" for the profile singleton
  lang       String // target language of this translation
  fields     Json // { fieldName: string | string[] }
  manual     Boolean  @default(false) // hand-written; automatic translation never overwrites it
  sourceHash String? // hash of the source text when translated; a mismatch = out of date
  updatedAt  DateTime @updatedAt

  @@unique([entity, entityId, lang])
}
